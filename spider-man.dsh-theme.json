    },
    "tokens": {
      "--dsw-alias-bg-base": "#0a080c",
      "--dsw-alias-bg-layer-1": "rgba(226, 54, 54, 0.05)",
      "--dsw-alias-bg-layer-2": "rgba(20, 14, 18, 0.88)",
      "--dsw-alias-bg-layer-3": "#1a1218",
      "--dsw-alias-bg-module-platform": "#120c12",
      "--dsw-alias-bg-overlay": "rgba(14, 10, 16, 0.88)",
